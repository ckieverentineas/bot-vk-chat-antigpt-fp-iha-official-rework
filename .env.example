DATABASE_URL="file:./dev.db?socket_timeout=600&connection_limit=1"
root=123456789

# Можно указать только token: бот сам определит страницу или группу, idvk и имя.
# Для многострочного VK_ENTITIES нужны внешние одинарные кавычки.
VK_ENTITIES='[
    {
        token: "VK_PAGE_OR_GROUP_TOKEN"
    },
    {
        token: "ANOTHER_VK_PAGE_OR_GROUP_TOKEN"
    },
]'

# stream - экономит ОЗУ и читает базу порциями.
# cache - загружает вопросы и стоп-слова в память, быстрее, но требует больше ОЗУ.
SEARCH_MODE=stream
SEARCH_BATCH_SIZE=10000
SEARCH_TOP_LIMIT=1

# Необязательно: свой .ttf шрифт для картинок в режиме !обучение.
# Если не указать, бот попробует найти системный Arial/Segoe UI/DejaVu Sans.
# QUESTION_IMAGE_FONT="C:\Windows\Fonts\arial.ttf"
